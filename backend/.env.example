# Required: Sarvam API subscription key (https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Fallback TTS language when the reply language can't be detected
SARVAM_LANGUAGE=hi-IN
# Bulbul v3 voice
SARVAM_SPEAKER=shubh
# STT language; "unknown" = auto-detect
STT_LANGUAGE=unknown
# Default LLM: sarvam-30b or sarvam-105b
LLM_MODEL=sarvam-30b

# Comma-separated browser origins allowed to call the API / open the websocket ("*" = any)
ALLOWED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177
# Bind address and port for `python main.py`
HOST=127.0.0.1
PORT=8004
